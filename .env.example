# Optional overrides for where generated files are read from and written to.
# Relative defaults are resolved against the repository root.
# The CLI and dashboard read these from the process environment, e.g. `set -a; source .env; set +a`.

# Simulated dataset (CSV + NPZ)
ADAPTIVE_QKD_DATA_DIR=data
# Trained classifiers
ADAPTIVE_QKD_MODEL_DIR=models
# Evaluation reports, benchmark tables and plots
ADAPTIVE_QKD_RESULTS_DIR=results
